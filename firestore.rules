rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    // Site settings: Publicly readable and updateable by admin
    match /siteSettings/{document} {
      allow read, write: if true;
    }

    // Public gym programs & gallery
    match /gymPrograms/{document} {
      allow read, write: if true;
    }

    match /gallery/{document} {
      allow read, write: if true;
    }

    match /offers/{document} {
      allow read, write: if true;
    }

    match /discounts/{document} {
      allow read, write: if true;
    }

    // User profiles
    match /users/{userId} {
      allow read, write: if true;
    }

    // Admission applications - prospective members apply online
    match /admissionApplications/{applicationId} {
      allow read, write: if true;
    }

    // Memberships
    match /memberships/{membershipId} {
      allow read, write: if true;
    }

    // Payments
    match /payments/{paymentId} {
      allow read, write: if true;
    }

    // Notifications
    match /notifications/{notificationId} {
      allow read, write: if true;
    }

    // Audit logs
    match /auditLogs/{logId} {
      allow read, write: if true;
    }
  }
}
